(pcb full_plane.dsn
  (parser (string_quote ") (space_in_quoted_tokens on) (host_cad "KiCad's Pcbnew") (host_version "8.0.0"))
  (resolution um 10) (unit um)
  (structure
    (layer F.Cu (type signal) (property (index 0)))
    (layer In1.Cu (type power) (property (index 1)))
    (layer In2.Cu (type signal) (property (index 2)))
    (layer B.Cu (type signal) (property (index 3)))
    (boundary (rect pcb 0 -20000 30000 0))
    (via Via[0-3]_550:300_um) (plane RETURN (rect In1.Cu 1000 -12000 24000 -1000))
    (rule (width 200) (clearance 150) (clearance 50 (type smd_smd))))
  (placement (component IMG_PAD
      (place A 5000 -5000 front 0)
      (place B 5400 -5000 front 0)
      (place C 20000 -5000 front 0)
      (place D 5000 -15000 front 0)
      (place E 20000 -15000 front 0)))
  (library
    (image IMG_PAD (pin PAD 1 0 0))
    (padstack PAD (shape (rect F.Cu -400 -400 400 400)) (attach off))
    (padstack Via[0-3]_550:300_um
      (shape (circle F.Cu 550)) (shape (circle In1.Cu 550))
      (shape (circle In2.Cu 550)) (shape (circle B.Cu 550)) (attach off)))
  (network (net RETURN (pins A-1 B-1 C-1))
    (net SIG (pins D-1 E-1))
    (class SIGNAL SIG (circuit (use_layer F.Cu)) (rule (width 200) (clearance 150))))
  (wiring 
      (wire (path F.Cu 200 5000 -5000 5000 -8000) (net RETURN) (type fix))
      (wire (path F.Cu 200 20000 -5000 20000 -8000) (net RETURN) (type fix))
      (via Via[0-3]_550:300_um 5000 -8000 (net RETURN) (type fix))
      (via Via[0-3]_550:300_um 20000 -8000 (net RETURN) (type fix))
    ))
