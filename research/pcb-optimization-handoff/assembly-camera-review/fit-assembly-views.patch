+      if (!mesh.geometry.boundingBox) mesh.geometry.computeBoundingBox();
+      bounds.union(meshBounds.copy(mesh.geometry.boundingBox).applyMatrix4(mesh.matrixWorld));
+    });
+  }
+  if (bounds.isEmpty()) bounds.setFromObject(plate);
+  const center = bounds.getCenter(new THREE.Vector3());
+  const half = bounds.getSize(new THREE.Vector3()).multiplyScalar(.5);
+  // Give OrbitControls a stable horizontal axis at the nearly vertical preset.
+  const outward = (mode === 'top' ? new THREE.Vector3(0, -.0001, 1)
+    : mode === 'side' ? new THREE.Vector3(0, -1, .12)
+      : new THREE.Vector3(.85, -1, .95)).normalize();
+  const right = new THREE.Vector3().crossVectors(camera.up, outward).normalize();
+  const up = new THREE.Vector3().crossVectors(outward, right);
+  const frame = framingArea();
+  const verticalFov = Math.tan(THREE.MathUtils.degToRad(camera.getEffectiveFOV()) / 2);
+  const tanY = verticalFov * .84 * frame.height / innerHeight;
+  const tanX = verticalFov * .84 * frame.width / innerHeight;
+  const corner = new THREE.Vector3();
+  let distance = camera.near * 2;
+  // A corner nearer the camera has a smaller frustum cross-section.
+  for (const x of [-half.x, half.x]) {
+    for (const y of [-half.y, half.y]) {
+      for (const z of [-half.z, half.z]) {
+        corner.set(x, y, z);
+        const fit = Math.max(Math.abs(corner.dot(right)) / tanX,
+          Math.abs(corner.dot(up)) / tanY, camera.near * 2);
+        distance = Math.max(distance, corner.dot(outward) + fit);
+      }
+    }
+  }
+  camera.far = Math.max(5000, distance + 2 * half.length());
+  camera.setViewOffset(innerWidth, innerHeight,
+    (innerWidth - frame.width) / 2 - frame.left,
+    (innerHeight - frame.height) / 2 - frame.top, innerWidth, innerHeight);
