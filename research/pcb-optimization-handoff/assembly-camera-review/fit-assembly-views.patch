+function framingArea() {
+  const panel = document.getElementById('panel').getBoundingClientRect();
+  const hover = document.getElementById('hover').getBoundingClientRect();
+  // Fit beside the overlays on wide screens or between them on tall screens.
+  const beside = {left: Math.max(panel.right, hover.right) + 12, top: 0};
+  beside.width = Math.max(0, innerWidth - beside.left);
+  beside.height = innerHeight;
+  const between = {left: 0, top: panel.bottom + 12, width: innerWidth};
+  between.height = Math.max(0, hover.top - 12 - between.top);
+  const fit = beside.width * beside.height >= between.width * between.height ? beside : between;
+  return fit.width > 32 && fit.height > 32 ? fit
+    : {left: 0, top: 0, width: innerWidth, height: innerHeight};
+}
