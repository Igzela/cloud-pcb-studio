@@ -0,0 +1,109 @@
+"""Copper containment and layer identity in the optional polygon pad export."""
+
+import math
+
+import pytest
+from kiutils.board import Board
+from kiutils.footprint import Footprint, Pad
+from kiutils.items.common import Net, Position
+from shapely.geometry import LineString, Point, Polygon, box
+from shapely.affinity import rotate, translate
+
+from cloud_pcb.layout_route.dsn_ses_bridge import _parse_sexpr, board_to_dsn
+from contracts.schemas import NetClassRule
+
+
+def _child(parent, key):
+    return next(item for item in parent if isinstance(item, list) and item[0] == key)
+
+
+def _capacitor(ref, pad_shape='roundrect', pad_angle=-17.0, side='F.Cu', ratio=.35):
+    return Footprint(
+        position=Position(X=8.2344, Y=4.2066, angle=37),
+        properties={'Reference': ref},
+        pads=[Pad(number='1', shape=pad_shape,
+                  position=Position(X=.3455, Y=-.92125, angle=pad_angle),
+                  layers=[side], size=Position(X=1.1753, Y=.5437), roundrectRatio=ratio)],
+    )
+
+
+def _export(footprints, path, **options):
+    board = Board.create_new()
+    net = Net(1, 'LINK')
+    board.nets.append(net)
+    board.footprints.extend(footprints)
+    for footprint in footprints:
+        footprint.pads[0].net = net
+    text = board_to_dsn(board, path, {'DEFAULT': NetClassRule('DEFAULT', .16, .13, .30, .55, .5)}, {}, **options).read_text()
+    return text, _parse_sexpr(text)[0]
+
+
+def _stacks(dsn):
+    library = _child(dsn, 'library')
+    pads = {item[1]: _child(item, 'pin')[1] for item in library[1:] if item[0] == 'image'}
+    shapes = {item[1]: [node[1] for node in item[2:] if node[0]=='shape']
+              for item in library[1:] if item[0] == 'padstack'}
+    return pads, shapes
+
+
+@pytest.mark.parametrize(('shape', 'side', 'angle', 'ratio'), [
+    ('roundrect', 'F.Cu', -17, .35), ('roundrect', 'B.Cu', 31, 0),
+    ('oval', 'B.Cu', 63, None), ('rect', 'F.Cu', 179.98, None),
+])
+def test_pad_polygon_contains_true_world_copper_with_absolute_position_rounding(tmp_path, shape, side, angle, ratio):
+    fp = _capacitor('CAP', shape, angle, side, ratio)
+    _, dsn = _export([fp], tmp_path/'precise.dsn', accurate_pad_geometry=True)
+    pads, stacks = _stacks(dsn)
+    shape_line, = stacks[pads['IMG_CAP']]
+    assert shape_line[:3] == ['polygon', side, '0']
+    placement = _child(_child(_child(dsn, 'placement'), 'component'), 'place')
+    pin = _child(_child(_child(dsn, 'library'), 'image'), 'pin')
+    center_x = (int(placement[2])+int(pin[3])) / 1000
+    center_y = (int(placement[3])+int(pin[4])) / 1000
+    points = [(center_x+int(x)/1000, center_y+int(y)/1000)
+              for x,y in zip(shape_line[3::2],shape_line[4::2])]
+    emitted = Polygon(points)
+    assert emitted.equals(emitted.convex_hull)
+
+    # Independent capsule/roundrect from KiCad y-down -> DSN y-up, using
+    # physical transforms rather than reconstructing exporter vertices.
+    th = math.radians(37)
+    local_x,local_y = .3455,.92125
+    cx = 8.2344 + local_x*math.cos(th) - local_y*math.sin(th)
+    cy = -4.2066 + local_x*math.sin(th) + local_y*math.cos(th)
+    w,h = 1.1753,.5437
+    radius = h/2 if shape=='oval' else h*ratio if shape=='roundrect' else 0
+    if shape=='oval':
+        core = LineString(((-w/2+radius,0),(w/2-radius,0)))
+    else:
+        core = box(-w/2+radius,-h/2+radius,w/2-radius,h/2-radius)
+    physical = translate(rotate(core.buffer(radius,quad_segs=256),angle,origin=(0,0)),cx,cy)
+    assert emitted.covers(physical)
+    assert emitted.difference(physical.buffer(.006)).area < 1e-12
+    assert Point(cx,cy).distance(Point(center_x,center_y)) <= math.sqrt(2)/2000
+
+
+def test_padstack_keys_distinguish_radius_and_exact_layers_without_changing_legacy(tmp_path):
+    footprints = [_capacitor('A'),_capacitor('B',ratio=.15),
+                  _capacitor('C',side='B.Cu'),_capacitor('D')]
+    footprints[-1].pads[0].type = 'thru_hole'
+    footprints.append(_capacitor('E'))
+    path = tmp_path/'board.dsn'
+    before, legacy = _export(footprints,path)
+    after, accurate = _export(footprints,path,accurate_pad_geometry=True)
+    assert _export(footprints,path,accurate_pad_geometry=False)[0]==before
+    for scope in ('structure','network','placement','wiring'):
+        assert _child(legacy,scope)==_child(accurate,scope)
+    ids, stacks = _stacks(accurate)
+    assert len(set(ids[ref] for ref in ('IMG_A','IMG_B','IMG_C','IMG_D')))==4
+    assert ids['IMG_E']==ids['IMG_A']
+    assert tuple(shape[1] for shape in stacks[ids['IMG_D']])==('F.Cu','In1.Cu','In2.Cu','B.Cu')
+    assert all('.' not in name for name in ids.values())
+    assert _export(footprints,path,accurate_pad_geometry=True)[0]==after
+
+
+def test_rounded_polygon_mode_fails_closed_if_chamfer_is_known_but_unsupported(tmp_path):
+    fp = _capacitor('A')
+    fp.pads[0].chamfer = ['top_left']
+    with pytest.raises(ValueError, match='Chamfered copper'):
+        _export([fp],tmp_path/'board.dsn',accurate_pad_geometry=True)
