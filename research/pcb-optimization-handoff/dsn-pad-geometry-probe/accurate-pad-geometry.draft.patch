+def _convex_pad_vertices(
+    pad: Any, angle_deg: float,
+) -> tuple[tuple[int, int], ...]:
+    """Conservative copper outline in DSN y-up micrometres, relative to its pin."""
+    from shapely.geometry import MultiPoint
+
+    width, height = float(pad.size.X), float(pad.size.Y)
+    if not all(math.isfinite(n) for n in (width, height, angle_deg)) or min(width, height) <= 0:
+        raise ValueError("Pad polygon requires positive dimensions and a finite angle")
+    if getattr(pad, "chamfer", None) or getattr(pad, "chamferRatio", None):
+        raise ValueError("Chamfered copper needs its own pad geometry")
+    if pad.shape == "oval":
+        radius = min(width, height) / 2.0
+    elif pad.shape == "roundrect":
+        ratio = .25 if pad.roundrectRatio is None else float(pad.roundrectRatio)
+        if not math.isfinite(ratio) or not 0.0 <= ratio <= .5:
+            raise ValueError("Roundrect pad radius ratio must be in [0, .5]")
+        radius = min(width, height) * ratio
+    elif pad.shape == "rect":
+        radius = 0.0
+    else:
+        raise ValueError("Unsupported convex pad shape")
+
+    # The true pad is a core box (a line for an oval) plus a disk.
+    # Circumscribe that disk with a regular polygon. After rounding, any
+    # support function can lose at most sqrt(2)*0.5 µm at a vertex, and at
+    # most the same amount again when the absolute pin center is quantized.
+    # The 2 µm bias protects both independently rounded coordinates.
+    half_x, half_y = width / 2.0 - radius, height / 2.0 - radius
+    sides = PAD_POLYGON_VERTEX_COUNT
+    vertex_radius = (radius + PAD_POLYGON_GRID_MARGIN_MM) / math.cos(math.pi / sides)
+    theta = math.radians(angle_deg % 180)
+    c, s = math.cos(theta), math.sin(theta)
+    angles = [(index + .5) * math.tau / sides for index in range(sides)]
+    disk_offsets = [(vertex_radius * math.cos(a), vertex_radius * math.sin(a)) for a in angles]
+    samples = [
+        (round(1000 * (x*c - y*s + dx)), round(1000 * (x*s + y*c + dy)))
+        for x in (-half_x, half_x)
+        for y in (-half_y, half_y)
+        for dx, dy in disk_offsets
+    ]
+    polygon = MultiPoint(samples).convex_hull
+    if polygon.geom_type != "Polygon" or not polygon.is_valid:
+        raise ValueError("Pad copper is degenerate on the DSN grid")
+    vertices = tuple((int(x), int(y)) for x, y in polygon.exterior.coords[:-1])
+    start = vertices.index(min(vertices))
+    return vertices[start:] + vertices[:start]
+
