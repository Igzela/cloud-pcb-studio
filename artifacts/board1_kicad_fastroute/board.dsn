      (pin Rect_T_800x260_um 2 -1900 750)
      (pin Rect_T_800x260_um 3 -1900 250)
      (pin Rect_T_800x260_um 4 -1900 -250)
      (pin Rect_T_800x260_um 5 -1900 -750)
      (pin Rect_T_800x260_um 6 -1900 -1250)
      (pin Rect_T_260x800_um 7 -1250 -1900)
      (pin Rect_T_260x800_um 8 -750 -1900)
