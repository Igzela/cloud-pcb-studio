    )
    (net MCU_NRST
      (pins U_MCU-23 R_NRST-2)
    )
    (net PWM_ACT1
      (pins U_MCU-11 J_ACT-3)
    )
    (net PWM_ACT2
      (pins U_MCU-12 J_ACT-4)
    )
    (net SENSE_1
