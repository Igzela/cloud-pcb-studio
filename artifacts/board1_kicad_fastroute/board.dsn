(pcb board.dsn
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (host_cad "KiCad's Pcbnew")
    (host_version "8.0.0")
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu
      (type signal)
      (property (index 0))
    )
    (layer In1.Cu
      (type power)
      (property (index 1))
    )
    (layer In2.Cu
      (type power)
      (property (index 2))
    )
    (layer B.Cu
      (type signal)
      (property (index 3))
    )
    (boundary
      (rect pcb 0 -40000 60000 0)
    )
    (keepout "" (rect F.Cu 52500 -12500 57500 -7500))
    (keepout "" (rect B.Cu 52500 -12500 57500 -7500))
    (keepout "" (rect B.Cu 31850 -21150 34150 -18850))
    (keepout "" (rect F.Cu 14200 -9850 20100 -8000))
    (via Via[0-3]_550:300_um)
    (rule
      (width 200)
      (clearance 150)
      (clearance 150 (type default_smd))
      (clearance 50 (type smd_smd))
    )
  )
