    )
    (net SENSE_2
      (pins R_ADC2-2 J_ACT-6)
    )
    (net TELEM_RF
      (pins U_MCU-17 J_RF-1)
    )
    (net USB_DM
      (pins J_USB-5 D_TVS-3 D_TVS-4 U_MCU-4)
    )
    (net USB_DP
      (pins J_USB-4 D_TVS-1 D_TVS-6 U_MCU-3)
    )
    (net VANA_2V5
      (pins U_LDO-5 C_ANA1-1 C_ANA2-1 U_MCU-6 U_MCU-7 C_MCU_ANA-1)
    )
    (net VBUS
      (pins J_USB-2 J_USB-7 R_TVS_PWR-1 C_IN1-1 C_IN2-1 R_EN-1 U_BUCK-3)
    )
    (net VBUS_TVS
      (pins D_TVS-5 R_TVS_PWR-2)
    )
    (class POWER_VBUS VBUS
      (circuit (use_via Via[0-3]_550:300_um) (use_layer F.Cu B.Cu))
      (rule (width 550) (clearance 150))
    )
    (class DIFF_USB_90 USB_DM USB_DP
      (circuit (use_layer F.Cu))
      (rule (width 211) (clearance 127))
    )
    (class RF_50 TELEM_RF
      (circuit (use_layer F.Cu))
      (rule (width 306) (clearance 200))
    )
    (class POWER_3V3 3V3 BUCK_SW
      (circuit (use_via Via[0-3]_550:300_um) (use_layer F.Cu B.Cu))
      (rule (width 400) (clearance 150))
    )
    (class DEFAULT ADC_IN1 ADC_IN2 BUCK_BST BUCK_EN BUCK_FB CC1 CC2 GND LED_ANODE LED_STAT MCU_NRST PWM_ACT1 PWM_ACT2 SENSE_1 SENSE_2 VANA_2V5 VBUS_TVS
      (circuit (use_via Via[0-3]_550:300_um) (use_layer F.Cu B.Cu))
      (rule (width 200) (clearance 150))
    )
  )
  (wiring
  )
)
