    )
    (net BUCK_EN
      (pins R_EN-2 U_BUCK-5)
    )
    (net BUCK_FB
      (pins U_BUCK-4 R_FB1-2 R_FB2-1)
    )
    (net BUCK_SW
      (pins U_BUCK-2 C_BST-2 D_BUCK-2 L_BUCK-1)
    )
    (net CC1
