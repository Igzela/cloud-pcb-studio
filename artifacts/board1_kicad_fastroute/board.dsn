    )
    (net CC2
      (pins J_USB-6 R_CC2-1)
    )
    (net GND
      (pins J_USB-1 J_USB-8 J_USB-9 J_USB-10 J_USB-11 J_USB-12 R_CC1-2 R_CC2-2 D_TVS-2 C_IN1-2 C_IN2-2 U_BUCK-1 D_BUCK-1 R_FB2-2 C_OUT1-2 C_OUT2-2 C_LDO_IN-2 U_LDO-2 C_ANA1-2 C_ANA2-2 U_MCU-2 U_MCU-5 U_MCU-15 U_MCU-21 U_MCU-22 U_MCU-25 C_MCU1-2 C_MCU2-2 C_MCU_ANA-2 D_LED-2 J_RF-2 J_RF-3 J_ACT-2)
    )
    (net LED_ANODE
